{
  "name": "Ecom Revenue Diagnostic",
  "dataColors": ["#074650", "#009292", "#FE6DB6", "#480091", "#B66DFF", "#6DB6FF", "#914800", "#88A4BF"],
  "good": "#1A7F37",
  "bad": "#CF222E",
  "neutral": "#88A4BF",
  "background": "#FFFFFF",
  "foreground": "#0F1934",
  "tableAccent": "#074650",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0F1934" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0F1934" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A5568" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 32, "color": "#074650" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F7F8" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 8 }],
        "dropShadow": [{ "show": true, "preset": "BottomRight", "transparency": 85 }],
        "padding": [{ "top": 8, "bottom": 8, "left": 10, "right": 10 }],
        "title": [{ "show": true, "fontSize": 12, "fontColor": { "solid": { "color": "#0F1934" } } }]
      }
    },
    "slicer": {
      "*": {
        "data": [{ "mode": "Dropdown" }],
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "background": { "solid": { "color": "#074650" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontSize": 32, "color": { "solid": { "color": "#074650" } } }],
        "categoryLabels": [{ "show": true, "fontSize": 10, "color": { "solid": { "color": "#4A5568" } } }]
      }
    },
    "textbox": {
      "*": {
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
